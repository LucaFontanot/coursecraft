{
  "schema_version": 1,
  "id": "linear-lesson",
  "title": "Linear Lesson",
  "slide_size": { "w": 1280, "h": 720 },
  "scenes": [
    {
      "id": "sc-lesson",
      "title": "Lesson",
      "slides": [
        {
          "id": "s-title",
          "title": "Welcome",
          "duration_ms": 5000,
          "objects": [
            {
              "id": "title-heading",
              "name": "Course title",
              "kind": { "type": "text", "text": "Lesson Title", "style": { "size": 48, "bold": true } },
              "frame": { "x": 80, "y": 160, "w": 1120, "h": 76 }
            },
            {
              "id": "title-sub",
              "name": "Subtitle",
              "kind": { "type": "text", "text": "A short, structured lesson with objectives, key concepts, and a wrap-up.", "style": { "size": 22 } },
              "frame": { "x": 80, "y": 256, "w": 920, "h": 80 }
            },
            {
              "id": "btn-begin",
              "name": "Begin button",
              "kind": { "type": "button", "label": "Begin Lesson" },
              "frame": { "x": 80, "y": 420, "w": 220, "h": 56 }
            }
          ],
          "triggers": [
            { "action": { "action": "jump_to_slide", "target": "next" }, "when": { "event": "click", "object": "btn-begin" } }
          ]
        },
        {
          "id": "s-objectives",
          "title": "Learning Objectives",
          "duration_ms": 5000,
          "objects": [
            {
              "id": "obj-heading",
              "name": "Heading",
              "kind": { "type": "text", "text": "By the end of this lesson, you will be able to:", "style": { "size": 34, "bold": true } },
              "frame": { "x": 80, "y": 80, "w": 1120, "h": 60 }
            },
            {
              "id": "obj-list",
              "name": "Objectives list",
              "kind": { "type": "text", "text": "• Explain the core concept in plain language\n• Apply the three-step process in your daily work\n• Recognize common mistakes and how to avoid them", "style": { "size": 22 } },
              "frame": { "x": 80, "y": 180, "w": 1000, "h": 300 }
            },
            {
              "id": "obj-next",
              "name": "Next button",
              "kind": { "type": "button", "label": "Continue" },
              "frame": { "x": 1000, "y": 600, "w": 200, "h": 56 }
            }
          ],
          "triggers": [
            { "action": { "action": "jump_to_slide", "target": "next" }, "when": { "event": "click", "object": "obj-next" } }
          ]
        },
        {
          "id": "s-concepts",
          "title": "Key Concepts",
          "duration_ms": 5000,
          "objects": [
            {
              "id": "con-heading",
              "name": "Heading",
              "kind": { "type": "text", "text": "Explore the Three Steps", "style": { "size": 34, "bold": true } },
              "frame": { "x": 80, "y": 60, "w": 1120, "h": 56 }
            },
            {
              "id": "tab-1",
              "name": "Step 1 tab",
              "kind": { "type": "button", "label": "1. Prepare" },
              "frame": { "x": 80, "y": 140, "w": 220, "h": 52 }
            },
            {
              "id": "tab-2",
              "name": "Step 2 tab",
              "kind": { "type": "button", "label": "2. Execute" },
              "frame": { "x": 320, "y": 140, "w": 220, "h": 52 }
            },
            {
              "id": "tab-3",
              "name": "Step 3 tab",
              "kind": { "type": "button", "label": "3. Review" },
              "frame": { "x": 560, "y": 140, "w": 220, "h": 52 }
            },
            {
              "id": "con-intro",
              "name": "Prompt",
              "kind": { "type": "text", "text": "Select each step above to read the details.", "style": { "size": 20 } },
              "frame": { "x": 80, "y": 230, "w": 1000, "h": 120 }
            },
            {
              "id": "con-next",
              "name": "Next button",
              "kind": { "type": "button", "label": "Continue" },
              "frame": { "x": 1000, "y": 600, "w": 200, "h": 56 }
            }
          ],
          "layers": [
            {
              "id": "step-1",
              "name": "Step 1",
              "objects": [
                {
                  "id": "step-1-text",
                  "name": "Step 1 details",
                  "kind": { "type": "text", "text": "Step 1 — Prepare: Gather what you need and confirm the goal before starting.", "style": { "size": 22 } },
                  "frame": { "x": 80, "y": 230, "w": 1000, "h": 260 }
                }
              ]
            },
            {
              "id": "step-2",
              "name": "Step 2",
              "objects": [
                {
                  "id": "step-2-text",
                  "name": "Step 2 details",
                  "kind": { "type": "text", "text": "Step 2 — Execute: Follow the checklist in order and note any exceptions.", "style": { "size": 22 } },
                  "frame": { "x": 80, "y": 230, "w": 1000, "h": 260 }
                }
              ]
            },
            {
              "id": "step-3",
              "name": "Step 3",
              "objects": [
                {
                  "id": "step-3-text",
                  "name": "Step 3 details",
                  "kind": { "type": "text", "text": "Step 3 — Review: Verify the result and share a brief summary with your team.", "style": { "size": 22 } },
                  "frame": { "x": 80, "y": 230, "w": 1000, "h": 260 }
                }
              ]
            }
          ],
          "triggers": [
            { "action": { "action": "show_layer", "layer": "step-1" }, "when": { "event": "click", "object": "tab-1" } },
            { "action": { "action": "show_layer", "layer": "step-2" }, "when": { "event": "click", "object": "tab-2" } },
            { "action": { "action": "show_layer", "layer": "step-3" }, "when": { "event": "click", "object": "tab-3" } },
            { "action": { "action": "jump_to_slide", "target": "next" }, "when": { "event": "click", "object": "con-next" } }
          ]
        },
        {
          "id": "s-summary",
          "title": "Summary",
          "duration_ms": 3000,
          "objects": [
            {
              "id": "sum-heading",
              "name": "Heading",
              "kind": { "type": "text", "text": "Lesson Complete", "style": { "size": 40, "bold": true } },
              "frame": { "x": 80, "y": 160, "w": 1120, "h": 64 }
            },
            {
              "id": "sum-body",
              "name": "Takeaway",
              "kind": { "type": "text", "text": "Summarize the key takeaways and next steps for learners here.", "style": { "size": 22 } },
              "frame": { "x": 80, "y": 250, "w": 960, "h": 140 }
            }
          ],
          "triggers": [
            { "action": { "action": "complete_course", "status": "completed" }, "when": { "event": "timeline_starts" } }
          ]
        }
      ]
    }
  ]
}
